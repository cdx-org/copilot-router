{
  "name": "github-copilot-router",
  "version": "1.2.0",
  "description": "OpenAI & Anthropic compatible API router for GitHub Copilot SDK - Use Copilot with Claude Code, OpenAI Codex CLI, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gcr": "./dist/cli.js",
    "copilot-router": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github-copilot",
    "openai",
    "anthropic",
    "claude",
    "api",
    "router",
    "proxy",
    "llm",
    "ai",
    "copilot",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yatfuchan/github-copilot-router.git"
  },
  "homepage": "https://github.com/yatfuchan/github-copilot-router#readme",
  "bugs": {
    "url": "https://github.com/yatfuchan/github-copilot-router/issues"
  },
  "author": "yatfuchan",
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^0.1.17",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
